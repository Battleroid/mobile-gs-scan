<?xml version="1.0" encoding="utf-8"?>
<!--
    PebbleMark launcher foreground — geometry mirrors the inline SVG
    on the web side at `web/src/components/PebbleMark.tsx` and the
    design source at `studio.jsx:76-84`.

    Adaptive icon math: the safe zone for any device mask is the
    centre 72x72dp inside the 108x108 viewport. The PebbleMark's
    32-unit design viewBox scales by 2.25 to land inside that
    72-unit box (32*2.25=72), centred at (54, 54). Each shape's
    coordinates were translated from the design's `cx`/`cy`/`rx`/
    `ry` using:
       x' = 54 + (x - 16) * 2.25
       r' = r * 2.25

    Android VectorDrawable lacks a native `<ellipse>` element, so
    each ellipse is expressed as two arc segments closing on
    themselves (the standard SVG path-substitute for a full
    ellipse).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main pebble body — tomato ellipse, design cx=16 cy=17
         rx=13 ry=11 → centre (54, 56.25), radii (29.25, 24.75). -->
    <path
        android:fillColor="#FF5A36"
        android:pathData="M24.75,56.25 a29.25,24.75 0 1,0 58.5,0 a29.25,24.75 0 1,0 -58.5,0 z" />

    <!-- Soft highlight on the pebble's upper-left — translucent
         white ellipse, design cx=11.5 cy=13 rx=3.4 ry=2.4 →
         centre (43.875, 47.25), radii (7.65, 5.4). 50% alpha
         matches the web source's `opacity="0.5"`. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5"
        android:pathData="M36.225,47.25 a7.65,5.4 0 1,0 15.3,0 a7.65,5.4 0 1,0 -15.3,0 z" />

    <!-- Accent dot on the upper-right — tomato circle ringed in
         white. Design cx=22 cy=11 r=2.6 stroke=1.2 → centre
         (67.5, 42.75), r=5.85, stroke 2.7. -->
    <path
        android:fillColor="#FF5A36"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.7"
        android:pathData="M61.65,42.75 a5.85,5.85 0 1,0 11.7,0 a5.85,5.85 0 1,0 -11.7,0 z" />
</vector>
